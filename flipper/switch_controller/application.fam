App(
    appid="switch_controller",
    name="Switch Controller",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="switch_controller_app",
    requires=["gui", "serial"],
    stack_size=8 * 1024,
    fap_icon="icons/controller_10px.png",
    fap_category="GPIO",
    fap_description="Emulate Nintendo Switch Pro Controller via USB. Control your Switch with Flipper buttons or remotely via ESP32 WiFi bridge.",
)
